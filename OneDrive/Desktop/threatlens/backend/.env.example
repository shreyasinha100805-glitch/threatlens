# Leave MONGODB_URI unset for local demo mode with bundled sample logs.
# Set it in production to use MongoDB Atlas.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?appName=threatlens
PORT=8080
GOOGLE_CLOUD_PROJECT=threatlens-496915
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
